<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UnityBundleInspector.ViewModels"
             x:Class="UnityBundleInspector.Views.MainView"
             x:DataType="vm:MainViewModel">
    
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0">
                <MenuItem Header="File">
                    <MenuItem Header="Open File" />
                    <MenuItem Header="Open Folder" />
                    <Separator />
                    <MenuItem Header="Exit" />
                </MenuItem>
                <MenuItem Header="Options">
                    <MenuItem Header="Enable Preview" ToggleType="CheckBox" />
                </MenuItem>
            </Menu>
            <Border Grid.Column="1" />
            <SplitButton Grid.Column="2" Content="Toggle">
                <SplitButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="System" />
                        <MenuItem Header="Light" />
                        <MenuItem Header="Dark" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>
    </DockPanel>
    
</UserControl>
